---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Page not found - Timur Khairullin">
  <section class="section">
    <div class="container grid min-h-[58vh] place-items-center text-center">
      <div>
        <p class="eyebrow">404</p>
        <h1 class="mt-4 text-5xl font-black text-ink md:text-7xl">Страница не найдена</h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-8 text-muted">Возможно, ссылка изменилась или кейс еще готовится к публикации.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/">На главную</Button>
          <Button href="/cases/" variant="secondary">К кейсам</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
