---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import MockupFrame from '@/components/media/MockupFrame.astro';
import { freelanceProjects } from '@/data/freelanceProjects';
---

<BaseLayout title="Freelance Projects - Timur Khairullin">
  <section class="section">
    <div class="container grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="eyebrow">Freelance</p>
        <h1 class="mt-4 text-balance text-5xl font-black leading-tight text-ink md:text-6xl">20+ коммерческих проектов для компаний и частных заказчиков</h1>
        <p class="mt-6 text-lg leading-8 text-muted">
          Интерфейсы, сайты, лендинги, презентации, брендовые материалы, баннеры, печатная продукция, HTML-мокапы и отдельные frontend-модули.
        </p>
      </div>
      <MockupFrame variant="landing" title="Freelance project system" />
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <SectionTitle eyebrow="Project grid" title="Форматы freelance-задач" text="В проектах встречаются сайты, лендинги, интерфейсы, презентации, баннеры, бренд-материалы и frontend-модули для разных бизнес-задач" />
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {freelanceProjects.map((project, index) => (
          <article class="rounded-lg border border-slate-200 bg-white p-3 shadow-soft">
            <MockupFrame variant={index % 3 === 0 ? 'website' : index % 3 === 1 ? 'mobile' : 'brand'} title={project.category} />
            <div class="p-3">
              <div class="flex flex-wrap gap-2">
                <Badge>{project.category}</Badge>
                {project.nda && <Badge>NDA</Badge>}
              </div>
              <h2 class="mt-4 text-xl font-black text-ink">{project.title}</h2>
              <p class="mt-3 leading-7 text-muted">{project.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
