---
import { BriefcaseBusiness, CalendarDays, CheckCircle2, Code2, Layers3, MonitorSmartphone, Sparkles } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { experience } from '@/data/experience';

const details: Record<string, string[]> = {
  BinTech: [
    'Проектирование UI/UX для крупной государственной экосистемы.',
    'Развитие дизайн-системы в Figma и подготовка компонентов под React.',
    'Работа с аналитиками, backend-разработчиками и ограничениями реального продукта.',
  ],
  Freelance: [
    '20+ коммерческих проектов: сайты, лендинги, кабинеты, презентации, баннеры и visual design.',
    'Кликабельные HTML-мокапы с фейковыми данными и имитацией реальных сценариев.',
    'Полный цикл для небольших проектов: структура, дизайн, frontend, демонстрация и сопровождение.',
  ],
  'Helios Soft': [
    'ERP-интерфейсы, внутренние модули, корпоративный сайт и визуальные материалы.',
    'Брендбук, презентации, digital-графика и концепции мобильных сценариев.',
    'Совмещение роли дизайнера и senior programmer в продуктовых задачах.',
  ],
  'Center for Strategic Initiatives': [
    'Frontend на Vue.js для крупной информационной системы.',
    'Сложные формы, графики, визуализация данных и доработка пользовательских сценариев.',
    'Поддержка интерфейсов, где важны точность данных и понятность рабочих процессов.',
  ],
  Jobtron: [
    'Клиентская часть CRM и пользовательские компоненты.',
    'Переработка дизайн-концепции и улучшение UX рабочих сценариев.',
    'Frontend-доработки в продуктовой команде.',
  ],
  'GoSauda / Aman Systems / PING MEDIA / Foxinet': [
    'Торговые платформы, онлайн-кассы, складской учет и корпоративные сайты.',
    'Angular, Vue, Laravel, web design, frontend и маркетинговые материалы.',
    'Разные форматы задач: от интерфейсов до промо-графики и запуска страниц.',
  ],
};

const icons = [BriefcaseBusiness, Sparkles, Layers3, Code2, MonitorSmartphone, CalendarDays];
const freelance = experience.find((item) => item.company === 'Freelance');
const companies = experience.filter((item) => item.company !== 'Freelance');
---

<BaseLayout title="Опыт работы - Timur Khairullin">
  <section class="section dark-band">
    <div class="container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div class="reveal">
        <p class="eyebrow text-cyan">Experience</p>
        <h1 class="mt-4 text-balance text-5xl font-black leading-tight text-white md:text-7xl">Опыт работы по компаниям и проектам</h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Здесь собраны компании, продукты и роли, где я закрывал UI/UX, frontend, визуальную подачу, дизайн-системы и продуктовые задачи.
        </p>
      </div>
      <div class="reveal grid gap-4 sm:grid-cols-3">
        {['8+ лет', '20+ проектов', 'UI/UX + frontend'].map((item) => (
          <div class="glass-panel rounded-lg p-5">
            <p class="text-2xl font-black text-white">{item}</p>
            <p class="mt-2 text-sm text-slate-300">практический опыт</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {freelance && (
    <section class="section bg-white">
      <div class="container">
        <SectionTitle eyebrow="Freelance" title="Freelance как отдельный продуктовый кейс" text="Freelance-проекты показывают полный практический цикл: от упаковки идеи и интерфейса до кликабельной демонстрации, визуальных материалов и frontend-реализации" />
        <article class="reveal mt-10 grid gap-8 rounded-lg border border-slate-200 bg-slate-950 p-6 text-white shadow-soft lg:grid-cols-[0.72fr_1.28fr]">
          <div>
            <p class="text-sm font-bold text-cyan">{freelance.period}</p>
            <h2 class="mt-3 text-4xl font-black leading-tight">{freelance.company}</h2>
            <p class="mt-2 text-slate-300">{freelance.role} / {freelance.location}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {['web/mobile UI', 'лендинги', 'HTML-мокапы', 'presentations', 'brand'].map((tag) => <Badge tone="dark">{tag}</Badge>)}
            </div>
          </div>
          <div class="grid gap-3">
            {(details.Freelance ?? []).map((point) => (
              <div class="flex gap-3 rounded-lg border border-white/10 bg-white/8 p-4">
                <CheckCircle2 size={20} class="mt-0.5 shrink-0 text-lime-200" />
                <p class="leading-7 text-slate-200">{point}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="section bg-slate-50">
    <div class="container">
      <SectionTitle eyebrow="Companies" title="Компании и роли" text="Каждая позиция показывает вклад в продукт, интерфейс, визуальную систему, frontend-реализацию и рабочие процессы команды" />
      <div class="mt-10 grid gap-5">
        {companies.map((item, index) => {
          const Icon = icons[index] ?? BriefcaseBusiness;
          const points = details[item.company] ?? [item.summary];
          return (
            <article class="reveal experience-row rounded-lg border border-slate-200 bg-white p-6 shadow-soft">
              <div>
                <span class="grid size-12 place-items-center rounded-lg bg-ink text-white">
                  <Icon size={22} aria-hidden="true" />
                </span>
                <p class="mt-5 text-sm font-bold text-blue">{item.period}</p>
                <h2 class="mt-2 text-3xl font-black leading-tight text-ink">{item.company}</h2>
                <p class="mt-2 text-sm font-semibold text-muted">{item.role} / {item.location}</p>
              </div>
              <div>
                <p class="leading-7 text-muted">{item.summary}</p>
                <div class="mt-5 grid gap-3">
                  {points.map((point) => (
                    <div class="flex gap-3 rounded-lg bg-slate-50 p-4">
                      <CheckCircle2 size={18} class="mt-1 shrink-0 text-blue" />
                      <p class="leading-7 text-muted">{point}</p>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
