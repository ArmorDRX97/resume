---
import { MessageCircle, Phone, Send, Sparkles } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { contact } from '@/data/contact';

const phoneDigits = contact.phone.replace(/\D/g, '');
const phoneHref = `tel:+${phoneDigits}`;
const whatsapp = `https://wa.me/${phoneDigits}`;
const contactCards = [
  {
    title: 'Телефон',
    text: contact.phone,
    href: phoneHref,
    icon: Phone,
    tone: 'bg-ink text-white',
  },
  {
    title: 'WhatsApp',
    text: contact.phone,
    href: whatsapp,
    icon: MessageCircle,
    tone: 'bg-[#25D366] text-white',
  },
  {
    title: 'Telegram',
    text: '@ArmorDRX',
    href: contact.telegram,
    icon: Send,
    tone: 'bg-[#229ED9] text-white',
  },
];
---

<BaseLayout title="Контакты - Timur Khairullin">
  <section class="hero-wave-section relative isolate overflow-hidden bg-graphite text-white">
    <canvas data-hero-scene data-wave-theme="contact" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="hero-grid pointer-events-none absolute inset-0"></div>
    <div class="noise-overlay pointer-events-none absolute inset-0 opacity-20"></div>
    <div class="hero-readability pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-graphite to-transparent"></div>

    <div class="container relative z-10 flex min-h-[calc(74vh-64px)] flex-col items-center justify-center py-20 text-center">
      <p class="reveal eyebrow text-cyan">Contact</p>
      <h1 class="reveal mt-4 max-w-4xl text-balance text-5xl font-black leading-tight text-white md:text-7xl">Связаться со мной</h1>
      <p class="reveal mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl">
        {contact.availability}.
      </p>
      <div class="reveal mt-8 flex flex-wrap justify-center gap-2">
        <Badge tone="dark">{contact.city}</Badge>
        <Badge tone="dark">Remote</Badge>
        <Badge tone="dark">Project ready</Badge>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <SectionTitle align="center" eyebrow="Channels" title="Каналы связи" text="Выберите удобный способ: позвонить, написать в WhatsApp или Telegram" />
      <div class="mx-auto mt-10 grid max-w-5xl gap-5 md:grid-cols-3">
        {contactCards.map((card) => {
          const Icon = card.icon;
          return (
            <a class="reveal magnetic-card group rounded-lg border border-slate-200 bg-white p-6 shadow-soft" href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel={card.href.startsWith('http') ? 'noreferrer' : undefined}>
              <span class={`grid size-14 place-items-center rounded-lg ${card.tone}`}>
                <Icon size={25} aria-hidden="true" />
              </span>
              <h2 class="mt-5 text-2xl font-black text-ink">{card.title}</h2>
              <p class="mt-2 break-words leading-7 text-muted">{card.text}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-black text-blue">
                Открыть <Sparkles size={15} class="transition group-hover:rotate-12" />
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    import '@/scripts/hero-scene';
  </script>
</BaseLayout>
