---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Кейсы - Timur Khairullin">
  <section class="section">
    <div class="container max-w-3xl">
      <p class="eyebrow">Cases</p>
      <h1 class="mt-4 text-balance text-5xl font-black leading-tight text-ink md:text-6xl">Кейсы и работы</h1>
      <p class="mt-5 text-lg leading-8 text-muted">Работы сгруппированы по форматам: готовые сайты, HTML-мокапы, дизайн-кейсы, презентации и digital-графика</p>
      <div class="mt-8">
        <Button href="/cases/">Смотреть кейсы</Button>
      </div>
    </div>
  </section>
</BaseLayout>
