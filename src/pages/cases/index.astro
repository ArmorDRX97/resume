---
import { ArrowUpRight, ExternalLink, Images, Link2, Maximize2, Monitor, PenTool, ShieldCheck } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { withBase } from '@/utils/path';

const tabs = [
  { id: 'sites', label: 'Готовые сайты', icon: Monitor },
  { id: 'designs', label: 'Figma-дизайны', icon: PenTool },
] as const;

const caseItems = [
  {
    tab: 'sites',
    title: 'Izbasar',
    description:
      'Сайт программы развития молодых специалистов Казатомпрома. Проект собран как готовая верстка с адаптивной структурой и мини-backend на Laravel для наглядной демонстрации работы сайта.',
    cover: '/images/portfolio/sites/izbasar/cover.jpg',
    url: 'https://izbasar.kazatomprom.kz/',
    tags: ['site', 'responsive', 'Laravel', 'career program'],
    role: 'UI/UX, frontend, backend',
  },
  {
    tab: 'sites',
    title: 'Murager',
    description:
      'Сайт программы образовательных грантов Казатомпрома. В проекте важны ясная подача условий, доверительный визуальный тон и готовая реализация для демонстрации заявки и ключевых разделов.',
    cover: '/images/portfolio/sites/murager/cover.jpg',
    url: 'https://murager.kazatomprom.kz/',
    tags: ['site', 'responsive', 'Laravel', 'education'],
    role: 'UI/UX, frontend, backend',
  },
  {
    tab: 'sites',
    title: 'QazQar',
    description:
      'Сервис проката автомобилей без водителя. Работа включала визуальную концепцию, frontend и backend-логику, чтобы сайт можно было использовать как полноценную основу для сервиса.',
    cover: '/images/portfolio/sites/qazqar/cover.jpg',
    url: 'https://qazqar.kz/',
    tags: ['rental service', 'UI/UX', 'frontend', 'backend'],
    role: 'UI/UX, frontend, backend',
  },
  {
    tab: 'sites',
    title: 'Helios Soft',
    description:
      'Многостраничный корпоративный сайт компании: структура, визуальная система, frontend и небольшой backend для управления контентом. Акцент сделан на понятной подаче услуг и доверии к бренду.',
    cover: '/images/portfolio/sites/helios-soft/cover.jpg',
    url: 'https://fvr.kz/',
    tags: ['corporate site', 'CMS', 'frontend', 'backend'],
    role: 'UI/UX, frontend, backend',
  },
  {
    tab: 'sites',
    title: 'BInTech',
    description:
      'Одностраничный сайт компании с прямой структурой, адаптивной версткой и фокусом на быструю презентацию направления, компетенций и контакта.',
    cover: '/images/portfolio/sites/bintech/cover.jpg',
    url: 'https://bintech.kz/',
    tags: ['one-page', 'corporate', 'responsive'],
    role: 'UI/UX, frontend',
  },
  {
    tab: 'sites',
    title: 'Aitia Systems',
    description:
      'Концепт дизайна для многостраничного сайта IT-компании. Публичная реализация отличается от исходной дизайн-концепции, но кейс показывает направление визуальной подачи и структуру продукта.',
    cover: '/images/portfolio/sites/aitia-systems/cover.jpg',
    url: 'https://aitiasystems.kz/',
    tags: ['concept', 'multipage', 'UI/UX'],
    role: 'UI/UX',
  },
  {
    tab: 'sites',
    title: 'ҚазМұнайГаз',
    description:
      'Работа с публичными страницами под существующую корпоративную систему: частичная реализация дизайна, верстка и адаптация интерфейсных блоков под действующий backend.',
    cover: '/images/portfolio/sites/kmg/cover.jpg',
    url: 'https://www.kmg.kz/',
    tags: ['corporate', 'frontend', 'existing backend'],
    role: 'UI/UX, frontend',
  },
  {
    tab: 'sites',
    title: 'Total Service',
    description:
      'Frontend-реализация сайта по сложному визуальному макету. Основной фокус был на аккуратной верстке, сохранении дизайн-деталей и адаптации интерфейса под разные экраны.',
    cover: '/images/portfolio/sites/total-service/cover.jpg',
    url: 'https://totalservice.kz/',
    tags: ['frontend', 'complex layout', 'responsive'],
    role: 'frontend',
  },
  {
    tab: 'designs',
    title: 'Balasan',
    description:
      'Дизайн продукта для учета детей через сканирование лиц: мобильное приложение, dashboard и UX-логика сценариев. В работе были продуманы путь пользователя, состояния интерфейса и процесс взаимодействия с системой.',
    cover: '/images/portfolio/figma/balasan/cover.jpg',
    url: 'https://embed.figma.com/design/cSPMBtyYVBjGI63XAlQ6eY/balasan-UI-UX?node-id=1510-57&embed-host=share',
    embed: 'https://embed.figma.com/design/cSPMBtyYVBjGI63XAlQ6eY/balasan-UI-UX?node-id=1510-57&embed-host=share',
    tags: ['mobile app', 'dashboard', 'face recognition', 'UX'],
    role: 'UI/UX, product logic',
    gallery: [
      { title: 'Мобильный сценарий', image: '/images/portfolio/figma/balasan/gallery/01-mobile-flow.png' },
      { title: 'Карточка и данные ребенка', image: '/images/portfolio/figma/balasan/gallery/02-child-profile.png' },
      { title: 'Сканирование лица', image: '/images/portfolio/figma/balasan/gallery/03-face-scan.png' },
      { title: 'Мобильный dashboard', image: '/images/portfolio/figma/balasan/gallery/04-dashboard-mobile.png' },
      { title: 'Состояния и дополнительные экраны', image: '/images/portfolio/figma/balasan/gallery/05-states.png' },
    ],
  },
  {
    tab: 'designs',
    title: 'HiTarget',
    description:
      'Дизайн сайта продукта, созданный совместно с другим дизайнером. Публичный сайт сейчас уже изменился, поэтому этот кейс показывает исходную визуальную концепцию, структуру экранов и подачу продукта.',
    cover: '/images/portfolio/figma/hitarget/cover.jpg',
    url: 'https://embed.figma.com/design/jHsDs7Rt0b0wp4Mb5Hg2hb/Hitarget?node-id=147-1&embed-host=share',
    embed: 'https://embed.figma.com/design/jHsDs7Rt0b0wp4Mb5Hg2hb/Hitarget?node-id=147-1&embed-host=share',
    tags: ['product site', 'web UI', 'Figma', 'collaboration'],
    role: 'UI/UX',
    gallery: [
      { title: 'Главная страница', image: '/images/portfolio/figma/hitarget/gallery/01-home.jpg' },
      { title: 'Dashboard', image: '/images/portfolio/figma/hitarget/gallery/02-dashboard.jpg' },
      { title: 'Состояние dashboard', image: '/images/portfolio/figma/hitarget/gallery/03-dashboard-state.jpg' },
      { title: 'Contact us', image: '/images/portfolio/figma/hitarget/gallery/04-contact-us.jpg' },
    ],
  },
  {
    tab: 'designs',
    title: 'Puls',
    description:
      'Концепт мобильного приложения медицинских услуг. Проработаны ключевые пользовательские сценарии: выбор услуги, запись, личные данные и структура экранов для дальнейшей разработки.',
    cover: '/images/portfolio/figma/puls/cover.jpg',
    url: 'https://embed.figma.com/design/5JLu7Y1RUZZoFhGq1Cq5vg/mobile-App-PULS-UI%5CUX?node-id=882-129&embed-host=share',
    embed: 'https://embed.figma.com/design/5JLu7Y1RUZZoFhGq1Cq5vg/mobile-App-PULS-UI%5CUX?node-id=882-129&embed-host=share',
    tags: ['mobile app', 'healthcare', 'UX flows', 'Figma'],
    role: 'UI/UX',
    gallery: [
      { title: 'Главный экран', image: '/images/portfolio/figma/puls/gallery/01-home.jpg' },
      { title: 'Сценарий услуги', image: '/images/portfolio/figma/puls/gallery/02-service-flow.jpg' },
      { title: 'Запись и детали', image: '/images/portfolio/figma/puls/gallery/03-booking-flow.jpg' },
      { title: 'Профиль пользователя', image: '/images/portfolio/figma/puls/gallery/04-profile.jpg' },
    ],
  },
  {
    tab: 'designs',
    title: 'QazQar Mobile App',
    description:
      'Мобильное приложение для проката автомобилей без водителя. Дизайн развивает визуальную систему сайта и закрывает основные сценарии: авторизация, подбор авто, фильтры и дальнейший путь к бронированию.',
    cover: '/images/portfolio/figma/qazqar-app/cover.jpg',
    url: 'https://embed.figma.com/design/NEKl84s43dYf3RJXJXZUz9/Qazqar-mobile-App-UI-UX?node-id=661-3622&embed-host=share',
    embed: 'https://embed.figma.com/design/NEKl84s43dYf3RJXJXZUz9/Qazqar-mobile-App-UI-UX?node-id=661-3622&embed-host=share',
    tags: ['mobile app', 'car rental', 'filters', 'UX'],
    role: 'UI/UX',
    gallery: [
      { title: 'Авторизация', image: '/images/portfolio/figma/qazqar-app/gallery/01-auth.jpg' },
      { title: 'Главная', image: '/images/portfolio/figma/qazqar-app/gallery/02-home.jpg' },
      { title: 'Список автомобилей', image: '/images/portfolio/figma/qazqar-app/gallery/03-car-list.jpg' },
      { title: 'Фильтры', image: '/images/portfolio/figma/qazqar-app/gallery/04-filters.jpg' },
    ],
  },
] as const;
---

<BaseLayout title="Кейсы - Timur Khairullin">
  <section class="section bg-slate-50">
    <div class="container">
      <div class="max-w-5xl">
        <SectionTitle
          eyebrow="Cases"
          title="Кейсы по форматам работ"
          text="Здесь собраны публичные проекты, которые можно показать без ограничений: готовые сайты с внешними ссылками и Figma-дизайны с галереей экранов. Так проще оценить тип задачи, визуальный уровень, сценарии и глубину проработки"
        />
      </div>

      <div class="reveal mt-8 overflow-hidden rounded-lg border border-blue/20 bg-white shadow-soft">
        <div class="grid gap-5 p-5 md:grid-cols-[auto_minmax(0,1fr)] md:items-start">
          <span class="grid size-12 place-items-center rounded-lg bg-slate-950 text-white">
            <ShieldCheck size={22} aria-hidden="true" />
          </span>
          <div>
            <p class="text-sm font-black uppercase tracking-normal text-blue">NDA и конфиденциальность</p>
            <p class="mt-2 max-w-5xl leading-7 text-muted">
              Большая часть проектов из компаний, разовых заказов и внутренних продуктовых задач защищена NDA. Такие работы нельзя показывать публично в полном объеме, поэтому в портфолио собраны доступные материалы, обобщенные фрагменты интерфейсов и кейсы, которые можно демонстрировать без нарушения договоренностей.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-2" data-case-tabs>
        {tabs.map((tab, index) => {
          const Icon = tab.icon;
          return (
            <button class={`case-tab inline-flex min-h-11 items-center gap-2 rounded-lg border px-4 py-2 text-sm font-black transition ${index === 0 ? 'is-active' : ''}`} type="button" data-tab={tab.id}>
              <Icon size={16} aria-hidden="true" />
              {tab.label}
            </button>
          );
        })}
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-case-grid>
        {caseItems.map((item) => {
          const hasGallery = 'gallery' in item && item.gallery.length > 0;
          return (
            <article class="case-item reveal magnetic-card grid h-full overflow-hidden rounded-lg border border-slate-200 bg-white p-3 shadow-soft" data-case-item data-tab-panel={item.tab}>
              {hasGallery ? (
                <div class="grid h-full">
                  <button
                    type="button"
                    class="case-cover group text-left"
                    data-open-case
                    data-title={item.title}
                    data-description={item.description}
                    data-url={item.url}
                    data-embed={item.embed}
                    data-role={item.role}
                    data-gallery={JSON.stringify(item.gallery.map((shot) => ({ ...shot, image: withBase(shot.image) })))}
                    aria-label={`Смотреть дизайн ${item.title}`}
                  >
                    <img src={withBase(item.cover)} alt={item.title} loading="lazy" />
                    <span class="case-cover-badge">
                      <Images size={13} /> {item.gallery.length}
                    </span>
                  </button>
                  <div class="case-card-body">
                    <div class="flex flex-wrap gap-2">
                      {item.tags.map((tag) => <Badge>{tag}</Badge>)}
                    </div>
                    <div>
                      <h2 class="text-2xl font-black leading-tight text-ink">{item.title}</h2>
                      <p class="mt-3 leading-7 text-muted">{item.description}</p>
                    </div>
                    <button
                      type="button"
                      class="case-card-action text-left"
                      data-open-case
                      data-title={item.title}
                      data-description={item.description}
                      data-url={item.url}
                      data-embed={item.embed}
                      data-role={item.role}
                      data-gallery={JSON.stringify(item.gallery.map((shot) => ({ ...shot, image: withBase(shot.image) })))}
                    >
                      <span class="inline-flex items-center gap-2"><PenTool size={16} /> Смотреть дизайн</span>
                      <ArrowUpRight size={17} />
                    </button>
                  </div>
                </div>
              ) : (
                <div class="grid h-full">
                  <a class="case-cover group text-left" href={item.url} target="_blank" rel="noreferrer" aria-label={`Открыть сайт ${item.title}`}>
                    <img src={withBase(item.cover)} alt={item.title} loading="lazy" />
                    <span class="case-cover-badge">
                      <ExternalLink size={13} /> site
                    </span>
                  </a>
                  <div class="case-card-body">
                    <div class="flex flex-wrap gap-2">
                      {item.tags.map((tag) => <Badge>{tag}</Badge>)}
                    </div>
                    <div>
                      <h2 class="text-2xl font-black leading-tight text-ink">{item.title}</h2>
                      <p class="mt-3 leading-7 text-muted">{item.description}</p>
                    </div>
                    <a class="case-card-action" href={item.url} target="_blank" rel="noreferrer">
                      <span class="inline-flex items-center gap-2"><ExternalLink size={16} /> Открыть сайт</span>
                      <ArrowUpRight size={17} />
                    </a>
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <aside class="case-drawer" aria-hidden="true" data-case-drawer>
    <div class="case-drawer__panel">
      <div class="flex items-start justify-between gap-4 border-b border-slate-200 p-6">
        <div>
          <p class="text-sm font-bold text-blue">Figma case</p>
          <h2 class="mt-2 text-3xl font-black leading-tight text-ink" data-drawer-title></h2>
          <p class="mt-3 leading-7 text-muted" data-drawer-description></p>
          <p class="mt-3 text-sm font-bold text-slate-500" data-drawer-role></p>
        </div>
        <button class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-black text-ink" type="button" data-close-drawer>Закрыть</button>
      </div>
      <div class="grid gap-5 p-6">
        <a class="hidden items-center gap-2 rounded-lg bg-ink px-4 py-3 text-sm font-black text-white" href="#" target="_blank" rel="noreferrer" data-drawer-link>
          <Link2 size={16} /> Открыть Figma
        </a>
        <div class="case-embed hidden" data-drawer-embed-wrap>
          <iframe title="Figma preview" loading="lazy" allowfullscreen data-drawer-embed></iframe>
        </div>
        <div>
          <p class="mb-3 text-sm font-black uppercase tracking-normal text-blue">Галерея экранов</p>
          <div class="grid gap-3" data-drawer-gallery></div>
        </div>
      </div>
    </div>
  </aside>

  <div class="case-lightbox" aria-hidden="true" data-case-lightbox>
    <button class="case-lightbox__close" type="button" data-close-lightbox>Закрыть</button>
    <button class="case-lightbox__nav" type="button" data-lightbox-prev>Назад</button>
    <div class="case-lightbox__content">
      <img class="lightbox-image" src="" alt="" data-lightbox-image />
      <div class="mt-5 flex items-center justify-center gap-2 text-white">
        <Maximize2 size={18} />
        <h2 class="text-center text-2xl font-black" data-lightbox-title></h2>
      </div>
    </div>
    <button class="case-lightbox__nav" type="button" data-lightbox-next>Вперед</button>
  </div>

  <style>
    .case-tab {
      border-color: rgb(226 232 240);
      background: rgba(255, 255, 255, 0.8);
      color: rgb(51 65 85);
    }

    .case-tab.is-active {
      border-color: rgba(79, 140, 255, 0.5);
      background: #0f172a;
      color: white;
      box-shadow: var(--shadow-glow);
    }

    .case-item[hidden] {
      display: none;
    }

    .case-cover {
      position: relative;
      display: block;
      overflow: hidden;
      width: 100%;
      border-radius: 8px;
      border: 1px solid rgb(226 232 240);
      background: #e2e8f0;
      aspect-ratio: 16 / 10;
      cursor: pointer;
      padding: 0;
    }

    .case-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      transition: transform 480ms ease;
    }

    .case-item:hover .case-cover img {
      transform: scale(1.045);
    }

    .case-cover-badge {
      position: absolute;
      right: 1rem;
      top: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.7);
      background: rgba(255, 255, 255, 0.92);
      padding: 0.35rem 0.7rem;
      color: var(--color-ink);
      font-size: 0.75rem;
      font-weight: 900;
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(12px);
    }

    .case-card-body {
      display: grid;
      gap: 1rem;
      padding: 1rem;
    }

    .case-card-action {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border: 0;
      border-top: 1px solid rgb(241 245 249);
      background: transparent;
      padding-top: 1rem;
      color: var(--color-blue);
      font-size: 0.875rem;
      font-weight: 900;
      cursor: pointer;
    }

    .case-drawer,
    .case-lightbox {
      position: fixed;
      inset: 0;
      z-index: 80;
      pointer-events: none;
      opacity: 0;
      transition: opacity 220ms ease;
    }

    .case-drawer {
      background: rgba(7, 10, 18, 0.46);
    }

    .case-drawer.is-open,
    .case-lightbox.is-open {
      pointer-events: auto;
      opacity: 1;
    }

    .case-drawer__panel {
      margin-left: auto;
      min-height: 100%;
      width: min(760px, 100%);
      overflow-y: auto;
      background: #fff;
      box-shadow: -28px 0 90px rgba(15, 23, 42, 0.28);
      transform: translateX(100%);
      transition: transform 280ms ease;
    }

    .case-drawer.is-open .case-drawer__panel {
      transform: translateX(0);
    }

    .case-embed {
      overflow: hidden;
      border-radius: 8px;
      border: 1px solid rgb(226 232 240);
      background: #f8fafc;
      aspect-ratio: 16 / 9;
    }

    .case-embed iframe {
      width: 100%;
      height: 100%;
      border: 0;
    }

    .gallery-thumb {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: center;
      border: 1px solid rgb(226 232 240);
      border-radius: 8px;
      background: #fff;
      padding: 0.75rem;
      text-align: left;
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
    }

    .gallery-thumb:hover {
      transform: translateY(-2px);
      border-color: rgba(79, 140, 255, 0.45);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    }

    .gallery-art {
      overflow: hidden;
      min-height: 72px;
      border-radius: 8px;
      border: 1px solid rgb(226 232 240);
      background: #e2e8f0;
    }

    .gallery-art img {
      display: block;
      width: 100%;
      height: 72px;
      object-fit: cover;
      object-position: top center;
    }

    .case-lightbox {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem;
      background: rgba(2, 6, 23, 0.92);
      padding: 2rem;
    }

    .case-lightbox__content {
      min-width: 0;
    }

    .lightbox-image {
      display: block;
      max-height: min(76vh, 820px);
      max-width: min(1120px, 100%);
      margin-inline: auto;
      border-radius: 8px;
      object-fit: contain;
      box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
    }

    .case-lightbox__close,
    .case-lightbox__nav {
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.1);
      color: white;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      font-weight: 900;
    }

    .case-lightbox__close {
      position: absolute;
      right: 2rem;
      top: 2rem;
    }

    @media (max-width: 760px) {
      .case-lightbox {
        grid-template-columns: 1fr;
        padding: 1rem;
      }

      .case-lightbox__close {
        right: 1rem;
        top: 1rem;
      }

      .gallery-thumb {
        grid-template-columns: 88px minmax(0, 1fr);
      }

      .gallery-art img {
        height: 64px;
      }
    }
  </style>

  <script>
    // @ts-nocheck
    const tabs = document.querySelectorAll('[data-tab]');
    const items = document.querySelectorAll('[data-case-item]');
    const drawer = document.querySelector('[data-case-drawer]');
    const drawerTitle = document.querySelector('[data-drawer-title]');
    const drawerDescription = document.querySelector('[data-drawer-description]');
    const drawerRole = document.querySelector('[data-drawer-role]');
    const drawerLink = document.querySelector('[data-drawer-link]');
    const drawerEmbedWrap = document.querySelector('[data-drawer-embed-wrap]');
    const drawerEmbed = document.querySelector('[data-drawer-embed]');
    const drawerGallery = document.querySelector('[data-drawer-gallery]');
    const lightbox = document.querySelector('[data-case-lightbox]');
    const lightboxTitle = document.querySelector('[data-lightbox-title]');
    const lightboxImage = document.querySelector('[data-lightbox-image]');
    let activeGallery = [];
    let activeIndex = 0;

    const setActiveTab = (active) => {
      tabs.forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-tab') === active));
      items.forEach((item) => item.toggleAttribute('hidden', item.getAttribute('data-tab-panel') !== active));
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setActiveTab(tab.getAttribute('data-tab'));
      });
    });

    setActiveTab(tabs[0]?.getAttribute('data-tab'));

    const openLightbox = (index) => {
      activeIndex = index;
      const item = activeGallery[activeIndex];
      lightboxTitle.textContent = item.title;
      lightboxImage.src = item.image;
      lightboxImage.alt = item.title;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
    };

    document.querySelectorAll('[data-open-case]').forEach((button) => {
      button.addEventListener('click', () => {
        activeGallery = JSON.parse(button.getAttribute('data-gallery') || '[]');
        drawerTitle.textContent = button.getAttribute('data-title') || '';
        drawerDescription.textContent = button.getAttribute('data-description') || '';
        drawerRole.textContent = button.getAttribute('data-role') ? `Роль: ${button.getAttribute('data-role')}` : '';

        const url = button.getAttribute('data-url');
        drawerLink.classList.toggle('hidden', !url);
        drawerLink.classList.toggle('inline-flex', Boolean(url));
        if (url) drawerLink.setAttribute('href', url);

        const embed = button.getAttribute('data-embed');
        drawerEmbedWrap.classList.toggle('hidden', !embed);
        if (embed) drawerEmbed.setAttribute('src', embed);

        drawerGallery.innerHTML = activeGallery
          .map((item, index) => `
            <button class="gallery-thumb" type="button" data-open-shot="${index}">
              <span class="gallery-art"><img src="${item.image}" alt="${item.title}" loading="lazy" /></span>
              <span>
                <span class="block text-base font-black text-ink">${item.title}</span>
                <span class="mt-1 block text-sm text-muted">Открыть экран крупнее</span>
              </span>
              <span class="hidden text-blue md:inline"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span>
            </button>
          `)
          .join('');
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
      });
    });

    drawerGallery.addEventListener('click', (event) => {
      const target = event.target.closest('[data-open-shot]');
      if (target) openLightbox(Number(target.getAttribute('data-open-shot')));
    });

    const closeDrawer = () => {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      drawerEmbed.removeAttribute('src');
    };

    document.querySelector('[data-close-drawer]').addEventListener('click', closeDrawer);

    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) closeDrawer();
    });

    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImage.removeAttribute('src');
    };

    document.querySelector('[data-close-lightbox]').addEventListener('click', closeLightbox);

    document.querySelector('[data-lightbox-prev]').addEventListener('click', () => {
      openLightbox((activeIndex - 1 + activeGallery.length) % activeGallery.length);
    });

    document.querySelector('[data-lightbox-next]').addEventListener('click', () => {
      openLightbox((activeIndex + 1) % activeGallery.length);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeLightbox();
        closeDrawer();
      }
    });
  </script>
</BaseLayout>
