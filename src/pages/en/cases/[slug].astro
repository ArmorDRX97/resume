---
import CaseStudyPage from '@/components/pages/CaseStudyPage.astro';
import { caseStudies } from '@/data/projects';

export function getStaticPaths() {
  return caseStudies.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<CaseStudyPage project={project} locale="en" />

