---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Навыки - Timur Khairullin">
  <section class="section">
    <div class="container max-w-3xl">
      <p class="eyebrow">Skills</p>
      <h1 class="mt-4 text-balance text-5xl font-black leading-tight text-ink md:text-6xl">Навыки и инструменты</h1>
      <p class="mt-5 text-lg leading-8 text-muted">Короткий обзор компетенций, инструментов и рабочих подходов на стыке дизайна, продукта, frontend и AI</p>
      <div class="mt-8">
        <Button href="/skills/">Смотреть навыки</Button>
      </div>
    </div>
  </section>
</BaseLayout>
