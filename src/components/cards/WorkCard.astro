---
import MockupFrame from '@/components/media/MockupFrame.astro';
type Work = {
  title: string;
  category: string;
  visual: 'dashboard' | 'website' | 'mobile' | 'brand' | 'landing' | 'charts' | 'system';
  tags: string[];
};

const { work } = Astro.props as { work: Work };
---

<article class="grid gap-4 rounded-lg border border-slate-200 bg-white p-3 shadow-soft">
  <MockupFrame title={work.category} variant={work.visual} />
  <div class="px-2 pb-2">
    <p class="text-xs font-bold uppercase tracking-[0.08em] text-blue">{work.category}</p>
    <h3 class="mt-2 text-lg font-black text-ink">{work.title}</h3>
    <div class="mt-3 flex flex-wrap gap-2">
      {work.tags.map((tag) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{tag}</span>)}
    </div>
  </div>
</article>
