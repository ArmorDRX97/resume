---
import { ArrowUpRight, ShieldCheck } from '@lucide/astro';
import Badge from '@/components/ui/Badge.astro';
import MockupFrame from '@/components/media/MockupFrame.astro';
import { localizedPath, ui, type Locale } from '@/data/site';
import type { CaseStudy } from '@/data/projects';
import { withBase } from '@/utils/path';

const { project, locale = 'ru', featured = false } = Astro.props as { project: CaseStudy; locale?: Locale; featured?: boolean };
const copy = ui[locale];
const href = localizedPath(locale, `/cases/${project.slug}/`);
---

<a href={withBase(href)} class={`project-card group grid h-full overflow-hidden rounded-lg border border-slate-200 bg-white p-3 shadow-soft ${featured ? 'project-card--featured' : ''}`}>
  <div class="project-card__media relative overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
    {project.cover ? (
      <img src={withBase(project.cover)} alt={`${project.title} — ${project.productType[locale]}`} loading="lazy" decoding="async" />
    ) : (
      <MockupFrame variant={project.visual} title={project.productType[locale]} />
    )}
  </div>
  <div class="grid content-start gap-4 p-4">
    <div class="flex flex-wrap items-center gap-2">
      <Badge>{project.productType[locale]}</Badge>
      {project.nda && (
        <span class="inline-flex items-center gap-1 rounded-full border border-blue/20 bg-blue/5 px-3 py-1 text-xs font-bold text-blue">
          <ShieldCheck size={13} aria-hidden="true" /> {copy.nda}
        </span>
      )}
    </div>
    <div>
      <h3 class="text-2xl font-black leading-tight text-ink md:text-3xl">{project.title}</h3>
      <p class="mt-2 text-sm font-bold text-blue">{project.role[locale]}</p>
      <p class="mt-3 leading-7 text-muted">{project.summary[locale]}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {project.tags.slice(0, 4).map((tag) => <Badge>{tag}</Badge>)}
    </div>
    <span class="mt-auto inline-flex items-center gap-2 border-t border-slate-100 pt-4 text-sm font-black text-blue">
      {copy.viewCase} <ArrowUpRight size={17} aria-hidden="true" />
    </span>
  </div>
</a>

