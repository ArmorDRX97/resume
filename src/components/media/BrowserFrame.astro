---
const { title = 'Browser preview' } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-soft">
  <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
    <div class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-red-300"></span>
      <span class="size-2.5 rounded-full bg-yellow-300"></span>
      <span class="size-2.5 rounded-full bg-green-300"></span>
    </div>
    <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-500">{title}</span>
  </div>
  <div class="p-4">
    <slot />
  </div>
</div>
