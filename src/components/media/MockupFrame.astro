---
type Variant = 'dashboard' | 'website' | 'mobile' | 'brand' | 'landing' | 'charts' | 'system';
interface Props {
  variant?: Variant;
  title?: string;
  dark?: boolean;
}

const { variant = 'dashboard', title = 'Interface preview', dark = false } = Astro.props as Props;
const palette: Record<Variant, string> = {
  dashboard: 'from-blue/20 via-cyan/10 to-white',
  website: 'from-cyan/20 via-white to-blue/10',
  mobile: 'from-violet/20 via-white to-cyan/10',
  brand: 'from-slate-200 via-white to-blue/10',
  landing: 'from-blue/15 via-white to-cyan/20',
  charts: 'from-cyan/15 via-white to-violet/10',
  system: 'from-blue/20 via-slate-50 to-cyan/10',
};
---

<div class={`mock-grid relative overflow-hidden rounded-lg border ${dark ? 'border-white/10 bg-white/8' : 'border-slate-200 bg-white'} p-4 shadow-soft`}>
  <div class={`absolute inset-0 bg-gradient-to-br ${palette[variant] ?? palette.dashboard}`}></div>
  <div class="relative rounded-lg border border-white/70 bg-white/76 p-3 shadow-soft backdrop-blur">
    <div class="mb-4 flex items-center justify-between border-b border-slate-200 pb-3">
      <div class="flex gap-1.5">
        <span class="size-2.5 rounded-full bg-red-300"></span>
        <span class="size-2.5 rounded-full bg-yellow-300"></span>
        <span class="size-2.5 rounded-full bg-green-300"></span>
      </div>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold uppercase text-slate-500">{title}</span>
    </div>

    {
      variant === 'mobile' ? (
        <div class="mx-auto grid h-72 max-w-[180px] gap-3 rounded-[26px] border-8 border-slate-900 bg-slate-50 p-4">
          <span class="h-4 rounded-full bg-blue/20"></span>
          <span class="h-20 rounded-lg bg-gradient-to-br from-blue/25 to-cyan/25"></span>
          <span class="h-8 rounded-lg bg-white shadow-sm"></span>
          <span class="h-8 rounded-lg bg-white shadow-sm"></span>
          <span class="h-10 rounded-lg bg-ink"></span>
        </div>
      ) : variant === 'brand' ? (
        <div class="grid gap-4 md:grid-cols-[0.8fr_1.2fr]">
          <div class="grid gap-3">
            <span class="aspect-square rounded-lg bg-ink"></span>
            <div class="grid grid-cols-3 gap-2">
              <span class="aspect-square rounded bg-blue"></span>
              <span class="aspect-square rounded bg-cyan"></span>
              <span class="aspect-square rounded bg-violet"></span>
            </div>
          </div>
          <div class="grid content-start gap-3">
            <span class="h-6 w-2/3 rounded bg-slate-900"></span>
            <span class="h-3 rounded bg-slate-200"></span>
            <span class="h-3 w-5/6 rounded bg-slate-200"></span>
            <span class="mt-3 h-24 rounded-lg bg-gradient-to-br from-slate-100 to-blue/20"></span>
          </div>
        </div>
      ) : (
        <div class="grid gap-4 md:grid-cols-[0.74fr_1.26fr]">
          <aside class="grid content-start gap-3 rounded-lg bg-slate-900 p-3">
            <span class="h-3 w-16 rounded bg-white/30"></span>
            <span class="h-8 rounded bg-white/10"></span>
            <span class="h-8 rounded bg-white/10"></span>
            <span class="h-8 rounded bg-white/10"></span>
          </aside>
          <section class="grid gap-3">
            <div class="grid grid-cols-3 gap-3">
              <span class="h-16 rounded-lg bg-blue/15"></span>
              <span class="h-16 rounded-lg bg-cyan/15"></span>
              <span class="h-16 rounded-lg bg-violet/15"></span>
            </div>
            <div class="grid gap-2 rounded-lg bg-white p-3 shadow-sm">
              <span class="h-3 w-1/2 rounded bg-slate-300"></span>
              <span class="h-3 rounded bg-slate-200"></span>
              <span class="h-3 rounded bg-slate-200"></span>
              <span class="h-3 w-4/5 rounded bg-slate-200"></span>
            </div>
            <div class="grid grid-cols-5 items-end gap-2 rounded-lg bg-slate-50 p-3">
              <span class="h-16 rounded bg-blue/30"></span>
              <span class="h-24 rounded bg-cyan/30"></span>
              <span class="h-12 rounded bg-violet/30"></span>
              <span class="h-20 rounded bg-blue/30"></span>
              <span class="h-28 rounded bg-cyan/30"></span>
            </div>
          </section>
        </div>
      )
    }
  </div>
</div>
