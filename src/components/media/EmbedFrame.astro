---
import { ExternalLink } from '@lucide/astro';

const { src = '', title = 'Interactive preview', height = 620 } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-soft">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3">
    <p class="text-sm font-bold text-ink">{title}</p>
    {src ? (
      <a class="inline-flex items-center gap-2 text-sm font-bold text-blue" href={src} target="_blank" rel="noreferrer">
        Open demo
        <ExternalLink size={15} aria-hidden="true" />
      </a>
    ) : (
      <span class="text-sm font-semibold text-slate-500">Demo placeholder</span>
    )}
  </div>
  {src ? (
    <iframe src={src} title={title} loading="lazy" style={`height:${height}px`} class="hidden w-full md:block"></iframe>
  ) : (
    <div class="grid min-h-72 place-items-center bg-slate-50 p-8 text-center text-slate-500">
      HTML mockup can be added later in <code class="rounded bg-white px-2 py-1">public/embeds/project-name/</code>
    </div>
  )}
</div>
