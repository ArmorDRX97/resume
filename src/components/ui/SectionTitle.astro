---
const { eyebrow, title, text, align = 'left', dark = false } = Astro.props;
const alignClass = align === 'center' ? 'mx-auto text-center' : '';
---

<div class={`max-w-3xl ${alignClass}`}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class={`text-balance text-3xl font-black leading-tight md:text-4xl ${dark ? 'text-white' : 'text-ink'}`}>
    {title}
  </h2>
  {text && <p class={`mt-5 text-lg leading-8 ${dark ? 'text-slate-300' : 'text-muted'}`}>{text}</p>}
</div>
