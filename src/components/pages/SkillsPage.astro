---
import { Bot, Braces, Boxes, MonitorSmartphone, Paintbrush, PanelsTopLeft, PenTool, Workflow } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { coreExpertise, skillSections } from '@/data/skills';
import type { Locale } from '@/data/site';

const { locale = 'ru' } = Astro.props as { locale?: Locale };
const coreIcons = [PenTool, Boxes, MonitorSmartphone, PanelsTopLeft, Braces, Workflow];
const sectionIcons = [PenTool, Paintbrush, PanelsTopLeft, Braces, Bot, Boxes];
---

<BaseLayout
  locale={locale}
  title={locale === 'ru' ? 'Навыки Product Designer — Timur Khairullin' : 'Product Designer skills — Timur Khairullin'}
  description={locale === 'ru' ? 'Product Design, сложные системы, UX/UI, дизайн-системы, техническое прототипирование и дополнительные инструменты.' : 'Product Design, complex systems, UX/UI, design systems, technical prototyping and supporting tools.'}
>
  <section class="section dark-band">
    <div class="container grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div class="reveal">
        <p class="eyebrow text-cyan">Skills</p>
        <h1 class="mt-4 text-balance text-5xl font-black leading-tight text-white md:text-7xl">{locale === 'ru' ? 'Один профиль. Несколько уровней компетенций.' : 'One profile. Multiple layers of capability.'}</h1>
      </div>
      <p class="reveal text-xl font-bold leading-8 text-slate-200">{locale === 'ru' ? 'В центре — Product Design. UX/UI, дизайн-системы и техническое прототипирование усиливают основную роль. AI, frontend и visual toolkit показаны в правильном масштабе.' : 'Product Design is the center. UX/UI, design systems and technical prototyping reinforce the core role, while AI, frontend and visual tools are shown at the right level.'}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <SectionTitle eyebrow="Professional Profile" title={locale === 'ru' ? 'Чем я силён в целом' : 'What I am strongest at'} text={locale === 'ru' ? 'Шесть направлений дают быстрый ответ без процентов, рейтингов и длинной стены логотипов.' : 'Six areas provide a fast answer without percentages, ratings or a wall of logos.'} />
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {coreExpertise.map((item, index) => {
          const Icon = coreIcons[index] ?? Boxes;
          return (
            <article class="reveal rounded-lg border border-slate-200 bg-white p-6 shadow-soft">
              <span class="grid size-11 place-items-center rounded-lg bg-ink text-white"><Icon size={21} aria-hidden="true" /></span>
              <h2 class="mt-5 text-2xl font-black text-ink">{item.title[locale]}</h2>
              <p class="mt-3 leading-7 text-muted">{item.text[locale]}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container">
      <SectionTitle eyebrow="Detailed Skills" title={locale === 'ru' ? 'Подробная декомпозиция' : 'Detailed breakdown'} text={locale === 'ru' ? 'Категории расположены по их значению для Product Designer, а не по количеству знакомых инструментов.' : 'Categories are ordered by their value to a Product Designer, not by the number of familiar tools.'} />
      <div class="mt-10 grid gap-5">
        {skillSections.map((section, index) => {
          const Icon = sectionIcons[index] ?? Boxes;
          return (
            <article class={`reveal skill-section-card grid gap-6 rounded-lg border border-slate-200 bg-white p-6 shadow-soft lg:grid-cols-[0.7fr_1.3fr] ${section.id === 'ai-workflow' || section.id === 'additional' ? 'skill-section-card--secondary' : ''}`}>
              <div>
                <span class="grid size-11 place-items-center rounded-lg bg-blue/10 text-blue"><Icon size={21} aria-hidden="true" /></span>
                <h2 class="mt-5 text-2xl font-black text-ink">{section.title[locale]}</h2>
                <p class="mt-3 leading-7 text-muted">{section.description[locale]}</p>
              </div>
              <div class="flex content-start flex-wrap gap-2 lg:pt-1">
                {section.items[locale].map((item) => <Badge>{item}</Badge>)}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
