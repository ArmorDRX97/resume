---
import { Mail, MessageCircle, Send, Sparkles } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import { contact } from '@/data/contact';

const phoneDigits = contact.phone.replace(/\D/g, '');
const whatsapp = `https://wa.me/${phoneDigits}`;
---

<section class="section bg-slate-950">
  <div class="container">
    <div class="dark-band relative overflow-hidden rounded-lg p-8 md:p-12">
      <div class="noise-overlay pointer-events-none absolute inset-0 opacity-20"></div>
      <div class="relative cta-layout">
        <div>
          <p class="eyebrow text-cyan">Contact</p>
          <h2 class="mt-3 text-balance text-3xl font-black leading-tight text-white md:text-5xl">
            Обсудим продукт, интерфейс или визуальную систему.
          </h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
            Могу подключиться как дизайнер, product-minded разработчик, frontend-специалист или AI-партнер для ускорения процесса.
          </p>
          <div class="mt-5 inline-flex items-center gap-2 rounded-full border border-lime-300/25 bg-lime-300/10 px-4 py-2 text-sm font-bold text-lime-200">
            <Sparkles size={16} aria-hidden="true" />
            {contact.availability}
          </div>
        </div>
        <div class="grid gap-3">
          <Button href={whatsapp} target="_blank" variant="light"><MessageCircle size={16} /> WhatsApp</Button>
          <Button href={`mailto:${contact.email}`} variant="light"><Mail size={16} /> Email</Button>
          <Button href={contact.telegram} target="_blank" variant="secondary"><Send size={16} /> Telegram</Button>
        </div>
      </div>
    </div>
  </div>
</section>
